{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": { "@/ui/*": ["./src/renderer/src/components/ui/*"], "@/*": ["./src/renderer/src/*"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "scripts",
    "test",
    "electron.vite.config.ts",
    "src/renderer/src",
    "src/main",
    "src/cli",
    "src/preload",
    "src/shared"
  ]
}
