{
  "name": "harbor-app",
  "productName": "Tawny",
  "version": "0.2.0",
  "description": "Orca-style agent workspaces with a fast Monaco editor + language servers (TypeScript/JavaScript, Ruby/Rails).",
  "main": "out/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "postinstall": "node scripts/fix-pty.js && node scripts/fetch-js-debug.js",
    "fetch:js-debug": "node scripts/fetch-js-debug.js",
    "predist": "electron-vite build && node scripts/fetch-js-debug.js",
    "land": "bash scripts/land.sh",
    "dist": "electron-builder --mac dmg",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.95.0",
    "@agentclientprotocol/sdk": "2.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "pele": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "lowlight": "^3.3.0",
    "marked": "^14.0.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.tawny.app",
    "productName": "Tawny",
    "files": [
      "out/**",
      "assets/**",
      "vendor/**",
      "node_modules/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@typescript/**",
      "node_modules/typescript/**",
      "node_modules/@agentclientprotocol/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/sdk/**",
      "node_modules/zod/**",
      "node_modules/diff/**",
      "vendor/js-debug/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    }
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
