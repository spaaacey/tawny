{
  "name": "tawny",
  "productName": "Tawny",
  "version": "0.2.0",
  "description": "Orca-style agent workspaces with a fast Monaco editor + language servers (TypeScript/JavaScript, Ruby/Rails).",
  "main": "out/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.ts",
    "postinstall": "node scripts/fix-pty.ts && node scripts/fetch-js-debug.ts",
    "fetch:js-debug": "node scripts/fetch-js-debug.ts",
    "predist": "electron-vite build && node scripts/fetch-js-debug.ts",
    "land": "bash scripts/land.sh",
    "dist": "electron-builder --mac dmg",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.95.0",
    "@agentclientprotocol/sdk": "2.0.2",
    "@shadcn/react": "^0.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "pele": "^1.10.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "typescript": "^7.0.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "lowlight": "^3.3.0",
    "marked": "^14.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.tawny.app",
    "productName": "Tawny",
    "afterPack": "scripts/after-pack.ts",
    "files": [
      "out/**",
      "assets/**",
      "vendor/**",
      "node_modules/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@typescript/**",
      "node_modules/typescript/**",
      "node_modules/@agentclientprotocol/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/sdk/**",
      "node_modules/zod/**",
      "node_modules/diff/**",
      "vendor/js-debug/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    }
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
