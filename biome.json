{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "**",
      "!out",
      "!vendor",
      "!node_modules",
      "!src/renderer/public",
      "!src/preload",
      "!scripts",
      "!test",
      "!package-lock.json",
      "!**/*.md",
      "!src/renderer/src/styles",
      "!src/renderer/src/ui/adapters/shadcn/*.tsx",
      "!src/renderer/src/legacy-markup.html"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/renderer/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "radix-ui": "Import UI from '@/ui' (docs/ui-layer.md)",
                  "lucide-react": "Import icons from '@/ui' (docs/ui-layer.md)",
                  "sonner": "Import UI from '@/ui' (docs/ui-layer.md)"
                },
                "patterns": [{ "group": ["**/ui/adapters/**"], "message": "Import UI from '@/ui' (docs/ui-layer.md)" }]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/src/ui/adapters/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["src/main/**"],
      "linter": {
        "rules": {
          "complexity": { "useOptionalChain": "off" },
          "suspicious": { "noAssignInExpressions": "off", "noControlCharactersInRegex": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
